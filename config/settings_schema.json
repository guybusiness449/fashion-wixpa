  {
    "name": "t:settings_groups.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings_labels.cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:settings_options.cart_type.drawer"
          },
          {
            "value": "page",
            "label": "t:settings_options.cart_type.page"
          }
        ],
        "default": "drawer",
        "info": "t:settings_info.cart_type"
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_progress",
        "label": "t:settings_labels.show_free_shipping_progress",
        "default": true,
        "info": "t:settings_info.show_free_shipping_progress"
      },
      {
        "type": "range",
        "id": "cart_free_shipping_threshold",
        "min": 0,
        "max": 500,
        "step": 10,
        "unit": "$",
        "label": "t:settings_labels.free_shipping_threshold",
        "default": 100,
        "info": "t:settings_info.free_shipping_threshold"
      },
      {
        "type": "checkbox",
        "id": "cart_show_notes",
        "label": "t:settings_labels.show_cart_notes",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_enable_ajax",
        "label": "t:settings_labels.enable_ajax_cart",
        "default": true,
        "info": "t:settings_info.enable_ajax_cart"
      }
    ]
  },
