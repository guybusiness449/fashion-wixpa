  {
    "name": "t:settings_groups.layout",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_content.layout_container"
      },
      {
        "type": "select",
        "id": "layout_max_width",
        "label": "t:settings_labels.page_max_width",
        "options": [
          {
            "value": "1200px",
            "label": "t:settings_options.page_max_width.narrow"
          },
          {
            "value": "1400px",
            "label": "t:settings_options.page_max_width.standard"
          },
          {
            "value": "1600px",
            "label": "t:settings_options.page_max_width.wide"
          },
          {
            "value": "100%",
            "label": "t:settings_options.page_max_width.full"
          }
        ],
        "default": "1400px"
      },
      {
        "type": "range",
        "id": "layout_section_spacing",
        "min": 40,
        "max": 120,
        "step": 10,
        "unit": "px",
        "label": "t:settings_labels.section_spacing",
        "default": 80,
        "info": "t:settings_info.section_spacing"
      },
      {
        "type": "range",
        "id": "layout_grid_gap",
        "min": 10,
        "max": 40,
        "step": 5,
        "unit": "px",
        "label": "t:settings_labels.grid_gap",
        "default": 20
      },
      {
        "type": "select",
        "id": "layout_corner_radius",
        "label": "t:settings_labels.corner_radius",
        "options": [
          {
            "value": "0",
            "label": "t:settings_options.corner_radius.none"
          },
          {
            "value": "4px",
            "label": "t:settings_options.corner_radius.small"
          },
          {
            "value": "8px",
            "label": "t:settings_options.corner_radius.medium"
          },
          {
            "value": "12px",
            "label": "t:settings_options.corner_radius.large"
          },
          {
            "value": "999px",
            "label": "t:settings_options.corner_radius.rounded"
          }
        ],
        "default": "4px"
      }
    ]
  },
