[
  {
    "name": "theme_info",
    "theme_name": "Fashion Wixpa",
    "theme_version": "1.0.0",
    "theme_author": "Your Name",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/",
    "theme_license": "https://www.shopify.com/legal/licenses/themes"
  },
  {
    "name": "t:settings_groups.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_content.typography_fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "assistant_n4",
        "label": "t:settings_labels.primary_font",
        "info": "t:settings_info.primary_font"
      },
      {
        "type": "font_picker",
        "id": "type_secondary_font",
        "default": "work_sans_n4",
        "label": "t:settings_labels.secondary_font",
        "info": "t:settings_info.secondary_font"
      },
      {
        "type": "range",
        "id": "type_base_font_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "t:settings_labels.base_font_size",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 1.2,
        "max": 1.6,
        "step": 0.1,
        "label": "t:settings_labels.heading_scale",
        "default": 1.4,
        "info": "t:settings_info.heading_scale"
      }
    ]
  },
